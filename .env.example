# Copy to .env and fill in. docker compose reads .env automatically.

# Deployment environment: "develop" or "production".
#   develop    -> Traefik serves the bundled self-signed certificate. No public
#                 domain or ACME needed. Leave CERT_RESOLVER empty.
#   production -> Traefik obtains a real certificate from Let's Encrypt.
#                 Set CERT_RESOLVER=le and a reachable DOMAIN + ACME_EMAIL.
ENVIRONMENT=develop

# Traefik certificate resolver. This is what actually switches TLS behaviour:
#   develop:    leave EMPTY  -> self-signed default cert (browser warning, ok for local)
#   production: set to  le   -> Let's Encrypt
CERT_RESOLVER=

# Public domain that resolves (via DNS) to this host. Used for routing,
# the TLS certificate, and the session cookie domain.
# In develop you can use e.g. grohe-dpf.localhost (covered by the self-signed cert).
DOMAIN=grohe-dpf.example.com

# Email Let's Encrypt uses for the certificate (expiry notices). Production only.
ACME_EMAIL=admin@example.com

# Database. The PHP backend connects as DB_USER; the dump is imported into DB_NAME.
DB_NAME=grohe-dpf
DB_USER=grohe
DB_PASSWORD=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
